{
  "name": "gestao-atendimentos-api",
  "version": "1.0.0",
  "description": "Backend SaaS multi-tenant para gestão de atendimentos (agenda, clientes, serviços, orçamentos, financeiro) — arquitetura Sotov + Prisma",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "dev:worker": "nodemon --watch src src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "admin:create": "node scripts/create-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/integration",
    "postinstall": "prisma generate"
  },
  "author": "Jefferson Santos",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "puppeteer": "^25.12.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.10"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
