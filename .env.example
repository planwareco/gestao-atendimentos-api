# ============================================================================
# Gestão de Atendimentos API — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================

NODE_ENV=development
PORT=3000
APP_NAME="Gestão de Atendimentos"
# URL do front (usada nos links dos e-mails e do checkout)
APP_URL=http://localhost:5173
# URL pública desta API (usada para montar o apiBaseUrl do PaymentWidget)
API_URL=http://localhost:3000
LOG_LEVEL=info
# Quantos proxies na frente da API (Render = 1)
TRUST_PROXY=1

# ---------------------------------------------------------------- Banco (Neon)
# Pooled (com -pooler no host) para a aplicação
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Direta (sem -pooler) para as migrations
DIRECT_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- Redis
# Obrigatório em produção (filas, cache e rate limit compartilhados).
# Vazio em dev: filas rodam inline e cache/rate-limit ficam em memória.
REDIS_URL=

# ---------------------------------------------------------------- CORS
# Origens do front separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Segredos
# Gere cada um com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
CHECKOUT_TOKEN_SECRET=
# 64 caracteres hex:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ADMIN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_REQUIRE_2FA=true
CHECKOUT_TOKEN_TTL=72h
# Deixe vazio se front e API estiverem em domínios diferentes
COOKIE_DOMAIN=

# ---------------------------------------------------------------- payment-system-mp
PAYMENTS_API_URL=https://payments.emanuelecode.tech
# Token de API do cliente (painel do payment-system-mp → Tokens). Escopos: payments:write, payments:read
PAYMENTS_API_TOKEN=pay_live_xxxxxxxx
# Public key do Mercado Pago (vai para o PaymentWidget — é segura para expor)
PAYMENTS_PUBLIC_KEY=APP_USR-xxxxxxxx
PAYMENTS_TIMEOUT_MS=10000

# ---------------------------------------------------------------- E-mail (Brevo)
BREVO_API_KEY=
EMAIL_FROM=nao-responda@seudominio.com
EMAIL_FROM_NAME="Gestão de Atendimentos"

# ---------------------------------------------------------------- PDF (worker)
# Caminho do Chrome/Chromium, se não usar o que o Puppeteer baixa
PUPPETEER_EXECUTABLE_PATH=

# ---------------------------------------------------------------- Testes
# Banco SEPARADO usado por `npm test` (é zerado a cada execução)
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/atend_test
